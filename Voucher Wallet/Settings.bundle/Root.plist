<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StringsTable</key>
    <string>Root</string>
    <key>PreferenceSpecifiers</key>
    <array>
        <!-- En-tête : À propos de l'apprentissage -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Apprentissage automatique</string>
            <key>FooterText</key>
            <string>"Mes bons d'achat" apprend automatiquement vos préférences pour améliorer la détection des enseignes et des couleurs associées.</string>
        </dict>
        
        <!-- Lien vers la page Statistiques -->
        <dict>
            <key>Type</key>
            <string>PSChildPaneSpecifier</string>
            <key>Title</key>
            <string>Statistiques</string>
            <key>File</key>
            <string>Statistics</string>
        </dict>
        
        <!-- Section : Démonstration -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Démonstration</string>
            <key>FooterText</key>
            <string>Activez cette option pour revoir l'écran de présentation au prochain lancement de "Mes bons d'achat".</string>
        </dict>
        
        <!-- Toggle pour relancer l'onboarding -->
        <dict>
            <key>Type</key>
            <string>PSToggleSwitchSpecifier</string>
            <key>Title</key>
            <string>Afficher la démonstration</string>
            <key>Key</key>
            <string>show_onboarding_next_launch</string>
            <key>DefaultValue</key>
            <false/>
        </dict>

        <!-- Section : Partage -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Partage</string>
            <key>FooterText</key>
            <string>Ce nom est affiché avec les dépenses que vous ajoutez sur les bons partagés.</string>
        </dict>

        <!-- Nom d'affichage des dépenses partagées -->
        <dict>
            <key>Type</key>
            <string>PSTextFieldSpecifier</string>
            <key>Title</key>
            <string>Nom d'affichage :</string>
            <key>Key</key>
            <string>sharedExpenseDisplayName</string>
            <key>DefaultValue</key>
            <string></string>
            <key>AutocapitalizationType</key>
            <string>Words</string>
            <key>AutocorrectionType</key>
            <string>Default</string>
        </dict>

        <!-- Réinitialisation du nom de partage -->
        <dict>
            <key>Type</key>
            <string>PSToggleSwitchSpecifier</string>
            <key>Title</key>
            <string>Redemander mon nom</string>
            <key>Key</key>
            <string>reset_shared_expense_identity</string>
            <key>DefaultValue</key>
            <false/>
        </dict>

        <!-- Section : Support -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Support</string>
            <key>FooterText</key>
            <string>Page de support : https://jrocher77.github.io/Voucher-Wallet/</string>
        </dict>
        
        <!-- Section : À propos -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>À propos</string>
        </dict>
        
        <!-- Version de l'app -->
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>Version</string>
            <key>Key</key>
            <string>version_preference</string>
            <key>DefaultValue</key>
            <string>2.0.2</string>
        </dict>
    </array>
</dict>
</plist>
