<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>StringsTable</key>
    <string>Root</string>
    <key>PreferenceSpecifiers</key>
    <array>
        <!-- En-tête : À propos de l'apprentissage -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Apprentissage automatique</string>
            <key>FooterText</key>
            <string>L'application apprend automatiquement vos préférences pour améliorer la détection des enseignes et des couleurs associées.</string>
        </dict>
        
        <!-- Lien vers la page Statistiques -->
        <dict>
            <key>Type</key>
            <string>PSChildPaneSpecifier</string>
            <key>Title</key>
            <string>Statistiques</string>
            <key>File</key>
            <string>Statistics</string>
        </dict>
        
        <!-- Section : Démonstration -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Démonstration</string>
            <key>FooterText</key>
            <string>Activez cette option pour revoir l'écran de présentation au prochain lancement de l'app.</string>
        </dict>
        
        <!-- Toggle pour relancer l'onboarding -->
        <dict>
            <key>Type</key>
            <string>PSToggleSwitchSpecifier</string>
            <key>Title</key>
            <string>Afficher la démonstration</string>
            <key>Key</key>
            <string>show_onboarding_next_launch</string>
            <key>DefaultValue</key>
            <false/>
        </dict>

        <!-- Section : Support -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>Support</string>
            <key>FooterText</key>
            <string>Page de support : https://jrocher77.github.io/Voucher-Wallet/</string>
        </dict>
        
        <!-- Section : À propos -->
        <dict>
            <key>Type</key>
            <string>PSGroupSpecifier</string>
            <key>Title</key>
            <string>À propos</string>
        </dict>
        
        <!-- Version de l'app -->
        <dict>
            <key>Type</key>
            <string>PSTitleValueSpecifier</string>
            <key>Title</key>
            <string>Version</string>
            <key>Key</key>
            <string>version_preference</string>
            <key>DefaultValue</key>
            <string>1.0</string>
        </dict>
    </array>
</dict>
</plist>
